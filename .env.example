# Sepnet LMS environment variables
# Copy this file to .env.local and adjust the values. Never commit .env.local.

# 4-digit cohort PIN — learners see released courses only (server-side only)
LMS_PIN=2115

# 4-digit PIN for the Sepnet owner account — unlocks everything.
# Choose your own code; leave unset to disable the admin account.
LMS_ADMIN_PIN=

# Comma-separated 4-digit PINs for hand-picked staff accounts — unlock everything.
# Choose your own codes; leave unset to disable all staff accounts.
LMS_STAFF_PINS=

# Secret used to sign the session cookie. Use a long random string in production.
LMS_SESSION_SECRET=change-me-to-a-long-random-string
